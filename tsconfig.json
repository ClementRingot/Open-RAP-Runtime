{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@open-rap-runtime/model": ["./packages/model/src/index.ts"],
      "@open-rap-runtime/compiler": ["./packages/compiler/src/index.ts"],
      "@open-rap-runtime/compiler/cli": ["./packages/compiler/src/cli.ts"],
      "@open-rap-runtime/runtime": ["./packages/runtime/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "e2e/**/*.ts", "vitest.config.ts"]
}
