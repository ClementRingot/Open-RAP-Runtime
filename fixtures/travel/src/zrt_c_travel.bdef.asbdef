projection;
strict ( 2 );

define behavior for ZRT_C_Travel alias Travel
use etag
{
  use create;
  use update;
  use delete;

  use action acceptTravel;

  use association _Booking { create; }
}

define behavior for ZRT_C_Booking alias Booking
use etag
{
  use update;
  use delete;

  use association _Travel;
}
