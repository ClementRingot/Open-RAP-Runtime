{
  "name": "rap-transpiler",
  "version": "0.1.0",
  "description": "rapt: develop, test and run SAP RAP business objects without an SAP system (OData V4, RAP managed runtime, transpiled ABAP, OpenUI5 UI).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://clementringot.github.io/RAP-Transpiler/",
  "keywords": ["abap", "rap", "sap", "cds", "odata", "abapgit", "openui5", "mcp"],
  "bin": {
    "rapt": "./bin/rapt.mjs"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@openui5/sap.f": "1.136.22",
    "@openui5/sap.m": "1.136.22",
    "@openui5/sap.ui.core": "1.136.22",
    "@openui5/sap.ui.layout": "1.136.22",
    "@openui5/sap.ui.unified": "1.136.22",
    "@openui5/sap.uxap": "1.136.22",
    "@openui5/themelib_sap_horizon": "1.136.22",
    "@rap-transpiler/compiler": "workspace:*",
    "@rap-transpiler/runtime": "workspace:*",
    "less-openui5": "0.12.0"
  }
}
