{
  "name": "open-rap-runtime",
  "version": "0.1.1",
  "description": "rapt, the command line of Open RAP Runtime: compiles SAP RAP sources (abapGit format) into a standalone Node.js OData V4 application, with what rapt dev serves (runtime, OpenUI5, PGlite).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://clementringot.github.io/Open-Rap-Runtime/",
  "keywords": [
    "sap",
    "rap",
    "abap",
    "cds",
    "odata",
    "odata-v4",
    "abapgit",
    "openui5",
    "cli"
  ],
  "bin": {
    "rapt": "./dist/rapt.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@openui5/sap.f": "1.136.22",
    "@openui5/sap.m": "1.136.22",
    "@openui5/sap.ui.core": "1.136.22",
    "@openui5/sap.ui.layout": "1.136.22",
    "@openui5/sap.ui.unified": "1.136.22",
    "@openui5/sap.uxap": "1.136.22",
    "@openui5/themelib_sap_horizon": "1.136.22",
    "@open-rap/compiler": "workspace:*",
    "@open-rap/runtime": "workspace:*",
    "less-openui5": "0.12.0"
  }
}
