{
  "name": "rap-transpiler-vscode",
  "displayName": "RAP Transpiler",
  "description": "Vérifier, générer et lancer un business object RAP sans système SAP : rap-transpiler, OpenUI5 et PGlite sont intégrés, rien d'autre à installer.",
  "version": "0.1.0",
  "publisher": "clementringot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClementRingot/rap-transpiler"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "abap",
    "rap",
    "cds",
    "odata",
    "abapgit"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.abapgit.xml",
    "workspaceContains:**/*.tabl.astabl",
    "onView:raptObjects"
  ],
  "contributes": {
    "languages": [
      {
        "id": "abap",
        "aliases": [
          "ABAP",
          "abap"
        ],
        "extensions": [
          ".abap"
        ],
        "configuration": "./syntaxes/abap.language-configuration.json"
      },
      {
        "id": "abap-cds",
        "aliases": [
          "ABAP CDS",
          "abap-cds"
        ],
        "extensions": [
          ".asddls",
          ".asddlxs",
          ".asdcls",
          ".srvdsrv",
          ".astabl",
          ".acds"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      },
      {
        "id": "abap-bdef",
        "aliases": [
          "ABAP Behavior Definition",
          "abap-bdef"
        ],
        "extensions": [
          ".asbdef"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap",
        "scopeName": "source.abap",
        "path": "./syntaxes/abap.tmLanguage"
      },
      {
        "language": "abap-cds",
        "scopeName": "source.abapcds",
        "path": "./syntaxes/abap-cds.tmLanguage.json"
      },
      {
        "language": "abap-bdef",
        "scopeName": "source.abapbdef",
        "path": "./syntaxes/abap-bdef.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rapt.check",
        "title": "Vérifier le BO",
        "category": "RAP",
        "icon": "$(check)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.build",
        "title": "Générer l'application…",
        "category": "RAP",
        "icon": "$(package)",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.devStart",
        "title": "Lancer rapt dev",
        "category": "RAP",
        "icon": "$(play)",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.devStop",
        "title": "Arrêter rapt dev",
        "category": "RAP",
        "icon": "$(debug-stop)",
        "enablement": "rapt.devRunning"
      },
      {
        "command": "rapt.openUi",
        "title": "Ouvrir l'application",
        "category": "RAP",
        "icon": "$(globe)",
        "enablement": "rapt.devRunning"
      },
      {
        "command": "rapt.showLog",
        "title": "Afficher le journal",
        "category": "RAP"
      },
      {
        "command": "rapt.newBo",
        "title": "Nouveau business object complet…",
        "category": "RAP",
        "icon": "$(new-folder)"
      },
      {
        "command": "rapt.abapgit",
        "title": "Générer les fichiers abapGit",
        "category": "RAP",
        "icon": "$(repo)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.generate",
        "title": "Nouvel objet RAP (listes rapides)…",
        "category": "RAP",
        "icon": "$(new-file)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.setMode",
        "title": "Choisir le mode du projet (standard / enhanced)",
        "category": "RAP",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.mcp",
        "title": "Générer le serveur MCP du service",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.newObject",
        "title": "Nouvel objet RAP…",
        "category": "RAP",
        "icon": "$(add)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.floorplan",
        "title": "Choisir le floorplan de l'application…",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.ir",
        "title": "Afficher la représentation intermédiaire (rapt ir)",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.launchpad",
        "title": "Générer un launchpad (rapt launchpad)",
        "category": "RAP"
      },
      {
        "command": "rapt.refreshObjects",
        "title": "Rafraîchir",
        "category": "RAP",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devRunning"
        },
        {
          "command": "rapt.generate",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rapt.newBo",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt1_create@1"
        },
        {
          "command": "rapt.newObject",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt1_create@2"
        },
        {
          "command": "rapt.check",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt2_project@1"
        },
        {
          "command": "rapt.abapgit",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt2_project@2"
        },
        {
          "command": "rapt.floorplan",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@1"
        },
        {
          "command": "rapt.devStart",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@2"
        },
        {
          "command": "rapt.build",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@3"
        }
      ],
      "editor/title": [
        {
          "command": "rapt.devStart",
          "when": "!rapt.devRunning && resourceExtname =~ /^\\.(asbdef|asddls|asddlxs|asdcls|srvdsrv|astabl|acds|abap|xml)$/",
          "group": "navigation@90"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devRunning",
          "group": "navigation@90"
        },
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning",
          "group": "navigation@91"
        }
      ],
      "view/title": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects",
          "group": "navigation@1"
        },
        {
          "command": "rapt.check",
          "when": "view == raptObjects",
          "group": "navigation@2"
        },
        {
          "command": "rapt.devStart",
          "when": "view == raptObjects && !rapt.devRunning",
          "group": "navigation@3"
        },
        {
          "command": "rapt.refreshObjects",
          "when": "view == raptObjects",
          "group": "navigation@4"
        },
        {
          "command": "rapt.newBo",
          "when": "view == raptObjects",
          "group": "1_create@1"
        }
      ],
      "view/item/context": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "inline"
        },
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt1_create@1"
        },
        {
          "command": "rapt.check",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt2_project@1"
        },
        {
          "command": "rapt.abapgit",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt2_project@2"
        },
        {
          "command": "rapt.floorplan",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@1"
        },
        {
          "command": "rapt.devStart",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@2"
        },
        {
          "command": "rapt.build",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@3"
        }
      ]
    },
    "configuration": {
      "title": "RAP Transpiler",
      "properties": {
        "rapt.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Chemin du `cli.js` de rapt, ou du dossier d'un clone rap-transpiler. Vide : la version de rapt intégrée à l'extension."
        },
        "rapt.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Exécutable Node.js (22 ou plus) qui lance rapt. Vide : le Node.js intégré à VS Code."
        },
        "rapt.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Vérifier le projet à chaque enregistrement (sauf quand rapt dev tourne déjà sur ce projet)."
        },
        "rapt.dev.port": {
          "type": "number",
          "default": 8080,
          "description": "Port de l'application lancée par rapt dev."
        },
        "rapt.dev.openUi": {
          "type": "boolean",
          "default": true,
          "description": "Ouvrir l'application dans le navigateur au premier démarrage de rapt dev."
        },
        "rapt.new.prefix": {
          "type": "string",
          "default": "Z",
          "description": "Préfixe proposé pour les objets d'un nouveau business object (Z ou Y…)."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "raptObjects",
          "name": "Objets RAP",
          "icon": "$(package)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "raptObjects",
        "contents": "Aucun projet RAP (.abapgit.xml) dans l'espace de travail.\n[Nouveau business object complet](command:rapt.newBo)\nCrée la table, les vues, la BDEF, le behavior pool et le service d'un BO ; ajoutez ensuite les objets un par un avec « Nouvel objet RAP… ».",
        "when": "!rapt.hasProject"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.cjs",
    "package": "pnpm run build && node scripts/stage-rapt.mjs && vsce package --no-dependencies --out rap-transpiler-vscode.vsix",
    "stage": "node scripts/stage-rapt.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
