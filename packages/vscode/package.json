{
  "name": "open-rap-runtime-vscode",
  "displayName": "Open RAP Runtime",
  "description": "Check, generate and run a RAP business object without an SAP system: Open RAP Runtime, OpenUI5 and PGlite are bundled, nothing else to install.",
  "version": "0.2.0",
  "publisher": "abaper",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClementRingot/Open-RAP-Runtime"
  },
  "bugs": {
    "url": "https://github.com/ClementRingot/Open-RAP-Runtime/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "abap",
    "rap",
    "cds",
    "odata",
    "abapgit"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.abapgit.xml",
    "workspaceContains:**/*.tabl.astabl",
    "onView:raptObjects"
  ],
  "contributes": {
    "languages": [
      {
        "id": "abap",
        "aliases": [
          "ABAP",
          "abap"
        ],
        "extensions": [
          ".abap"
        ],
        "configuration": "./syntaxes/abap.language-configuration.json"
      },
      {
        "id": "abap-cds",
        "aliases": [
          "ABAP CDS",
          "abap-cds"
        ],
        "extensions": [
          ".asddls",
          ".asddlxs",
          ".asdcls",
          ".srvdsrv",
          ".astabl",
          ".acds"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      },
      {
        "id": "abap-bdef",
        "aliases": [
          "ABAP Behavior Definition",
          "abap-bdef"
        ],
        "extensions": [
          ".asbdef"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap",
        "scopeName": "source.abap",
        "path": "./syntaxes/abap.tmLanguage"
      },
      {
        "language": "abap-cds",
        "scopeName": "source.abapcds",
        "path": "./syntaxes/abap-cds.tmLanguage.json"
      },
      {
        "language": "abap-bdef",
        "scopeName": "source.abapbdef",
        "path": "./syntaxes/abap-bdef.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rapt.check",
        "title": "Check the BO",
        "category": "RAP",
        "icon": "$(check)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.build",
        "title": "Build the application…",
        "category": "RAP",
        "icon": "$(package)",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.devStart",
        "title": "Start rapt dev",
        "category": "RAP",
        "icon": "$(play)",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.devStop",
        "title": "Stop rapt dev",
        "category": "RAP",
        "icon": "$(debug-stop)",
        "enablement": "rapt.devRunning"
      },
      {
        "command": "rapt.openUi",
        "title": "Open the application (or the launchpad)",
        "category": "RAP",
        "icon": "$(globe)",
        "enablement": "rapt.devReady"
      },
      {
        "command": "rapt.showLog",
        "title": "Show the log",
        "category": "RAP"
      },
      {
        "command": "rapt.feedback",
        "title": "Report a bug or request a feature…",
        "category": "RAP",
        "icon": "$(feedback)"
      },
      {
        "command": "rapt.newBo",
        "title": "New complete business object…",
        "category": "RAP",
        "icon": "$(new-folder)"
      },
      {
        "command": "rapt.abapgit",
        "title": "Generate the abapGit files",
        "category": "RAP",
        "icon": "$(repo)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.generate",
        "title": "New RAP object (quick picks)…",
        "category": "RAP",
        "icon": "$(new-file)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.setMode",
        "title": "Choose the project mode (standard / enhanced)",
        "category": "RAP",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.mcp",
        "title": "Generate the MCP server of the service",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.newObject",
        "title": "New RAP object…",
        "category": "RAP",
        "icon": "$(add)",
        "enablement": "rapt.hasProject && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.projects)"
      },
      {
        "command": "rapt.floorplan",
        "title": "Choose the floorplan of the application…",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.ir",
        "title": "Show the intermediate representation (rapt ir)",
        "category": "RAP",
        "enablement": "rapt.hasApp && ((!explorerResourceIsFolder && resourceFilename != .abapgit.xml) || resourcePath in rapt.apps)"
      },
      {
        "command": "rapt.launchpad",
        "title": "Build the launchpad (all the applications)…",
        "category": "RAP",
        "icon": "$(layout)",
        "enablement": "rapt.hasApp || rapt.hasLaunchpad"
      },
      {
        "command": "rapt.launchpadDev",
        "title": "Start the launchpad (rapt dev, all the applications)",
        "category": "RAP",
        "icon": "$(rocket)",
        "enablement": "rapt.hasApp || rapt.hasLaunchpad"
      },
      {
        "command": "rapt.refreshObjects",
        "title": "Refresh",
        "category": "RAP",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devReady"
        },
        {
          "command": "rapt.generate",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rapt.newBo",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt1_create@1"
        },
        {
          "command": "rapt.newObject",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt1_create@2"
        },
        {
          "command": "rapt.check",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt2_project@1"
        },
        {
          "command": "rapt.abapgit",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt2_project@2"
        },
        {
          "command": "rapt.floorplan",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@1"
        },
        {
          "command": "rapt.devStart",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@2"
        },
        {
          "command": "rapt.build",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt3_app@3"
        },
        {
          "command": "rapt.launchpadDev",
          "when": "resourceFilename == launchpad.json",
          "group": "rapt4_launchpad@1"
        },
        {
          "command": "rapt.launchpad",
          "when": "resourceFilename == launchpad.json",
          "group": "rapt4_launchpad@2"
        }
      ],
      "editor/title": [
        {
          "command": "rapt.devStart",
          "when": "!rapt.devRunning && resourceExtname =~ /^\\.(asbdef|asddls|asddlxs|asdcls|srvdsrv|astabl|acds|abap|xml)$/",
          "group": "navigation@90"
        },
        {
          "command": "rapt.launchpadDev",
          "when": "!rapt.devRunning && resourceFilename == launchpad.json",
          "group": "navigation@90"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devReady",
          "group": "navigation@90"
        },
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning",
          "group": "navigation@91"
        }
      ],
      "view/title": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects",
          "group": "navigation@1"
        },
        {
          "command": "rapt.check",
          "when": "view == raptObjects",
          "group": "navigation@2"
        },
        {
          "command": "rapt.devStart",
          "when": "view == raptObjects && !rapt.devRunning",
          "group": "navigation@3"
        },
        {
          "command": "rapt.launchpadDev",
          "when": "view == raptObjects && !rapt.devRunning && (rapt.hasApp || rapt.hasLaunchpad)",
          "group": "navigation@4"
        },
        {
          "command": "rapt.openUi",
          "when": "view == raptObjects && rapt.devReady",
          "group": "navigation@5"
        },
        {
          "command": "rapt.devStop",
          "when": "view == raptObjects && rapt.devRunning",
          "group": "navigation@6"
        },
        {
          "command": "rapt.refreshObjects",
          "when": "view == raptObjects",
          "group": "navigation@7"
        },
        {
          "command": "rapt.newBo",
          "when": "view == raptObjects",
          "group": "1_create@1"
        },
        {
          "command": "rapt.launchpadDev",
          "when": "view == raptObjects && (rapt.hasApp || rapt.hasLaunchpad)",
          "group": "2_launchpad@1"
        },
        {
          "command": "rapt.launchpad",
          "when": "view == raptObjects && (rapt.hasApp || rapt.hasLaunchpad)",
          "group": "2_launchpad@2"
        }
      ],
      "view/item/context": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "inline"
        },
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt1_create@1"
        },
        {
          "command": "rapt.check",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt2_project@1"
        },
        {
          "command": "rapt.abapgit",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt2_project@2"
        },
        {
          "command": "rapt.floorplan",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@1"
        },
        {
          "command": "rapt.devStart",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@2"
        },
        {
          "command": "rapt.build",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt3_app@3"
        }
      ]
    },
    "configuration": {
      "title": "Open RAP Runtime",
      "properties": {
        "rapt.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `cli.js` of rapt, or of the folder of an Open RAP Runtime clone. Empty: the rapt bundled with the extension."
        },
        "rapt.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Node.js executable (22 or later) that runs rapt. Empty: the Node.js of VS Code."
        },
        "rapt.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check the project on each save (except when rapt dev already runs on this project)."
        },
        "rapt.dev.port": {
          "type": "number",
          "default": 8080,
          "description": "Port of the application started by rapt dev."
        },
        "rapt.dev.openUi": {
          "type": "boolean",
          "default": true,
          "description": "Open the application in the browser when rapt dev first starts."
        },
        "rapt.new.prefix": {
          "type": "string",
          "default": "Z",
          "description": "Prefix proposed for the objects of a new business object (Z or Y…)."
        },
        "rapt.terminal.addToPath": {
          "type": "boolean",
          "default": true,
          "description": "Put the rapt command (the CLI of the extension) on the PATH of the integrated terminals, for you and for the AI agents that run commands."
        },
        "rapt.agent.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Offer the MCP server of rapt (`rapt agent`) to the agent mode of VS Code: check the project, create objects, read the documentation of Open RAP Runtime."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "raptObjects",
          "name": "RAP Objects",
          "icon": "$(package)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "raptObjects",
        "contents": "No RAP project (.abapgit.xml) in the workspace.\n[New complete business object](command:rapt.newBo)\nCreates the table, the views, the BDEF, the behavior pool and the service of a BO; then add objects one by one with \"New RAP object…\".",
        "when": "!rapt.hasProject"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "rapt.agent",
        "label": "rapt (Open RAP Runtime)"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.cjs",
    "package": "pnpm run build && node scripts/stage-rapt.mjs && vsce package --no-dependencies --out open-rap-runtime-vscode.vsix",
    "stage": "node scripts/stage-rapt.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
