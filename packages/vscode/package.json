{
  "name": "rap-transpiler-vscode",
  "displayName": "RAP Transpiler",
  "description": "Check, generate and run a RAP business object without an SAP system: rap-transpiler, OpenUI5 and PGlite are bundled, nothing else to install.",
  "version": "0.1.0",
  "publisher": "clementringot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ClementRingot/rap-transpiler"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "abap",
    "rap",
    "cds",
    "odata",
    "abapgit"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:**/.abapgit.xml",
    "workspaceContains:**/*.tabl.astabl",
    "onView:raptObjects"
  ],
  "contributes": {
    "languages": [
      {
        "id": "abap",
        "aliases": [
          "ABAP",
          "abap"
        ],
        "extensions": [
          ".abap"
        ],
        "configuration": "./syntaxes/abap.language-configuration.json"
      },
      {
        "id": "abap-cds",
        "aliases": [
          "ABAP CDS",
          "abap-cds"
        ],
        "extensions": [
          ".asddls",
          ".asddlxs",
          ".asdcls",
          ".srvdsrv",
          ".astabl",
          ".acds"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      },
      {
        "id": "abap-bdef",
        "aliases": [
          "ABAP Behavior Definition",
          "abap-bdef"
        ],
        "extensions": [
          ".asbdef"
        ],
        "configuration": "./syntaxes/cds.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "abap",
        "scopeName": "source.abap",
        "path": "./syntaxes/abap.tmLanguage"
      },
      {
        "language": "abap-cds",
        "scopeName": "source.abapcds",
        "path": "./syntaxes/abap-cds.tmLanguage.json"
      },
      {
        "language": "abap-bdef",
        "scopeName": "source.abapbdef",
        "path": "./syntaxes/abap-bdef.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "rapt.check",
        "title": "Check the BO",
        "category": "RAP",
        "icon": "$(check)"
      },
      {
        "command": "rapt.build",
        "title": "Build the application",
        "category": "RAP",
        "icon": "$(package)"
      },
      {
        "command": "rapt.devStart",
        "title": "Start rapt dev",
        "category": "RAP",
        "icon": "$(play)"
      },
      {
        "command": "rapt.devStop",
        "title": "Stop rapt dev",
        "category": "RAP",
        "icon": "$(debug-stop)"
      },
      {
        "command": "rapt.openUi",
        "title": "Open the application",
        "category": "RAP",
        "icon": "$(globe)"
      },
      {
        "command": "rapt.showLog",
        "title": "Show the log",
        "category": "RAP"
      },
      {
        "command": "rapt.newBo",
        "title": "New business object",
        "category": "RAP",
        "icon": "$(add)"
      },
      {
        "command": "rapt.abapgit",
        "title": "Generate the abapGit files",
        "category": "RAP",
        "icon": "$(repo)"
      },
      {
        "command": "rapt.generate",
        "title": "New RAP object… (table, view, BDEF, behavior pool, service…)",
        "category": "RAP",
        "icon": "$(new-file)"
      },
      {
        "command": "rapt.setMode",
        "title": "Choose the project mode (standard / enhanced)",
        "category": "RAP"
      },
      {
        "command": "rapt.mcp",
        "title": "Generate the MCP server of the service",
        "category": "RAP"
      },
      {
        "command": "rapt.newObject",
        "title": "New RAP object (wizard)…",
        "category": "RAP",
        "icon": "$(add)"
      },
      {
        "command": "rapt.floorplan",
        "title": "Choose the floorplan of the application (List Report, Worklist…)",
        "category": "RAP"
      },
      {
        "command": "rapt.ir",
        "title": "Show the intermediate representation (rapt ir)",
        "category": "RAP"
      },
      {
        "command": "rapt.launchpad",
        "title": "Generate a launchpad (rapt launchpad)",
        "category": "RAP"
      },
      {
        "command": "rapt.refreshObjects",
        "title": "Refresh",
        "category": "RAP",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devRunning"
        }
      ],
      "explorer/context": [
        {
          "command": "rapt.check",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@1"
        },
        {
          "command": "rapt.devStart",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@2"
        },
        {
          "command": "rapt.build",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@3"
        },
        {
          "command": "rapt.newBo",
          "when": "explorerResourceIsFolder || resourceFilename == .abapgit.xml",
          "group": "rapt@0"
        },
        {
          "command": "rapt.abapgit",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@4"
        },
        {
          "command": "rapt.generate",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@0"
        },
        {
          "command": "rapt.newObject",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@0"
        },
        {
          "command": "rapt.floorplan",
          "when": "resourceFilename == .abapgit.xml || explorerResourceIsFolder",
          "group": "rapt@5"
        }
      ],
      "editor/title": [
        {
          "command": "rapt.devStart",
          "when": "!rapt.devRunning && resourceExtname =~ /^\\.(asbdef|asddls|asddlxs|asdcls|srvdsrv|astabl|acds|abap|xml)$/",
          "group": "navigation@90"
        },
        {
          "command": "rapt.openUi",
          "when": "rapt.devRunning",
          "group": "navigation@90"
        },
        {
          "command": "rapt.devStop",
          "when": "rapt.devRunning",
          "group": "navigation@91"
        }
      ],
      "view/title": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects",
          "group": "navigation@1"
        },
        {
          "command": "rapt.check",
          "when": "view == raptObjects",
          "group": "navigation@2"
        },
        {
          "command": "rapt.devStart",
          "when": "view == raptObjects && !rapt.devRunning",
          "group": "navigation@3"
        },
        {
          "command": "rapt.refreshObjects",
          "when": "view == raptObjects",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "rapt.newObject",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "inline"
        },
        {
          "command": "rapt.floorplan",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt@1"
        },
        {
          "command": "rapt.abapgit",
          "when": "view == raptObjects && viewItem == raptProject",
          "group": "rapt@2"
        }
      ]
    },
    "configuration": {
      "title": "RAP Transpiler",
      "properties": {
        "rapt.cliPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path of the `cli.js` of rapt, or of the folder of a rap-transpiler clone. Empty: the rapt bundled with the extension."
        },
        "rapt.nodePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Node.js executable (22 or later) that runs rapt. Empty: the Node.js of VS Code."
        },
        "rapt.checkOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Check the project on each save (except when rapt dev already runs on this project)."
        },
        "rapt.dev.port": {
          "type": "number",
          "default": 8080,
          "description": "Port of the application started by rapt dev."
        },
        "rapt.dev.openUi": {
          "type": "boolean",
          "default": true,
          "description": "Open the application in the browser when rapt dev first starts."
        },
        "rapt.new.prefix": {
          "type": "string",
          "default": "Z",
          "description": "Prefix proposed for the objects of a new business object (Z or Y…)."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "raptObjects",
          "name": "RAP Objects",
          "icon": "$(package)"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && esbuild src/extension.ts --bundle --platform=node --target=node20 --format=cjs --external:vscode --sourcemap --outfile=dist/extension.cjs",
    "package": "pnpm run build && node scripts/stage-rapt.mjs && vsce package --no-dependencies --out rap-transpiler-vscode.vsix",
    "stage": "node scripts/stage-rapt.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  }
}
