{
  "name": "@rap-transpiler/runtime",
  "version": "0.1.0",
  "description": "Generic runtime of applications generated by rap-transpiler: OData V4 server and managed RAP runtime.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@abaplint/runtime": "2.14.24",
    "@rap-transpiler/model": "workspace:*",
    "chevrotain": "13.2.0",
    "fast-xml-parser": "5.12.0",
    "fastify": "5.12.8",
    "jose": "6.2.16",
    "kysely": "0.29.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@openui5/sap.f": "1.136.22",
    "@openui5/sap.m": "1.136.22",
    "@openui5/sap.ui.core": "1.136.22",
    "@openui5/sap.ui.layout": "1.136.22",
    "@openui5/sap.ui.unified": "1.136.22",
    "@openui5/sap.uxap": "1.136.22",
    "@openui5/themelib_sap_horizon": "1.136.22",
    "@rap-transpiler/compiler": "workspace:*",
    "@types/pg": "^8.23.1",
    "less-openui5": "0.12.0"
  }
}
