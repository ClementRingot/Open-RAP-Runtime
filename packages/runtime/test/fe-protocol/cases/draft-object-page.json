    {
      "id": "action-on-draft",
      "fails": "D81",
      "title": "an action of the application runs on a draft instance",
      "steps": [
        {
          "request": {
            "method": "POST",
            "url": "Travel(TravelUUID={{T1}},IsActiveEntity=true)/{{NS}}.Edit",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {
              "PreserveChanges": true
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "Travel(TravelUUID={{T1}},IsActiveEntity=false)/{{NS}}.acceptTravel",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {}
          },
          "expect": {
            "status": 200,
            "match": {
              "IsActiveEntity": false,
              "OverallStatus": "A"
            }
          }
        }
      ],
      "cleanup": [
        {
          "request": {
            "method": "POST",
            "url": "Travel(TravelUUID={{T1}},IsActiveEntity=false)/{{NS}}.Discard",
