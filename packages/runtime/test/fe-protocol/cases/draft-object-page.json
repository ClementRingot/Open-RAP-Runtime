      "steps": [
        {
          "request": {
            "method": "POST",
            "url": "Travel",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {
              "TravelID": "00000204",
              "AgencyID": "070001",
              "CustomerID": "000100",
              "CurrencyCode": "EUR"
            }
          },
          "capture": {
            "draft": "TravelUUID"
          },
          "expect": {
            "status": 201
          }
        },
        {
          "request": {
            "method": "POST",
            "url": "Travel(TravelUUID={{draft}},IsActiveEntity=false)/{{NS}}.Prepare",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {}
          }
        },
        {
          "request": {
            "method": "GET",
            "url": "Travel(TravelUUID={{draft}},IsActiveEntity=false)?$select=TravelUUID,SAP__Messages",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0"
            }
          },
          "expect": {
            "status": 200,
            "nonEmpty": [
              "SAP__Messages"
            ]
          }
        }
      ],
      "cleanup": [
        {
          "request": {
            "method": "POST",
            "url": "Travel(TravelUUID={{draft}},IsActiveEntity=false)/{{NS}}.Discard",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {}
          }
        }
      ]
    },
    {
      "id": "determination-on-draft-change",
      "fails": "D81",
      "title": "an on modify determination runs when the draft changes",
      "steps": [
        {
          "request": {
            "method": "POST",
            "url": "Travel",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {
              "TravelID": "00000205",
              "AgencyID": "070001",
              "CustomerID": "000100",
              "CurrencyCode": "EUR",
              "BookingFee": "10"
            }
          },
          "capture": {
            "draft": "TravelUUID"
          },
          "expect": {
            "status": 201
          }
        },
        {
          "request": {
            "method": "PATCH",
            "url": "Travel(TravelUUID={{draft}},IsActiveEntity=false)",
            "headers": {
              "Accept": "application/json;odata.metadata=minimal;IEEE754Compatible=true",
              "OData-Version": "4.0",
              "OData-MaxVersion": "4.0",
              "Content-Type": "application/json;charset=UTF-8;IEEE754Compatible=true",
              "If-Match": "*"
            },
            "body": {
              "BookingFee": "30"
            }
          },
          "expect": {
            "status": 200
          }
        },
        {
          "request": {
            "method": "GET",
