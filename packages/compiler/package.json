{
  "name": "@open-rap/compiler",
  "version": "0.2.1",
  "description": "Compiles SAP RAP sources (abapGit format) into a standalone Node.js OData V4 application.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://clementringot.github.io/Open-Rap-Runtime/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ClementRingot/Open-RAP-Runtime.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/ClementRingot/Open-RAP-Runtime/issues"
  },
  "keywords": [
    "sap",
    "rap",
    "abap",
    "cds",
    "odata",
    "odata-v4",
    "abapgit",
    "compiler",
    "cli"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "framework",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-docs.mjs"
  },
  "dependencies": {
    "@abaplint/core": "2.120.98",
    "@abaplint/transpiler": "2.14.24",
    "@open-rap/model": "workspace:*",
    "chevrotain": "13.2.0",
    "fast-xml-parser": "5.12.0"
  }
}
