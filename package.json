{
  "name": "open-rap-runtime-monorepo",
  "private": true,
  "type": "module",
  "description": "Compile SAP RAP sources (CDS, BDEF, behavior pool) into a standalone Node.js OData V4 application.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rapt": "node packages/compiler/dist/cli.js"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
